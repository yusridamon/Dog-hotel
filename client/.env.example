# ============================================================================
# Pawsome Stay Dog Hotel - Client environment variables
# Copy this file to `.env` and fill in real values (CRA reads .env at build).
# Only variables prefixed with REACT_APP_ are exposed to the browser bundle.
# ============================================================================

# Base URL of the API (WITHOUT the trailing /api - the client appends it).
#
# Local development: LEAVE THIS UNSET. The client defaults to '/api' and the
# CRA dev proxy (see "proxy" in package.json) forwards to http://localhost:5000.
#
# Production: set to the deployed API origin, e.g.
#   REACT_APP_API_URL="https://your-api.up.railway.app"
# The client will then call https://your-api.up.railway.app/api/...
# REACT_APP_API_URL=""
