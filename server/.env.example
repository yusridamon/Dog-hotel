# ============================================================================
# Pawsome Stay Dog Hotel - Server environment variables
# Copy this file to `.env` and fill in real values.
# All differences between local and production come from these variables, so
# the same code runs in both environments.
# ============================================================================

# --- Database (REQUIRED) ---------------------------------------------------
# PostgreSQL connection string.
# Local example:
DATABASE_URL="postgresql://username:password@localhost:5432/doghotel"
# Production (Railway/managed Postgres) will provide its own connection string,
# often including ?sslmode=require. Set it in the host's environment settings.

# --- Auth (REQUIRED) -------------------------------------------------------
# JWT signing secret. In PRODUCTION this MUST be a long, random secret
# (e.g. `openssl rand -hex 32`). Never commit the real value.
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
# Token lifetime (e.g. 7d, 24h). Optional; defaults to 7d in code.
JWT_EXPIRES_IN="7d"

# --- Server (REQUIRED for local; host usually injects PORT) ----------------
# Port the API listens on. Managed hosts inject their own PORT; code falls
# back to 5000 locally. The server binds to 0.0.0.0 so cloud hosts can reach it.
PORT=5000
# Environment mode: "development" locally, "production" on the live host.
NODE_ENV="development"

# --- CORS / Client origin (REQUIRED) ---------------------------------------
# Allowed browser origin(s) for the API. Falls back to http://localhost:3000.
# Supports a single origin OR a comma-separated list to allow multiple
# (e.g. the production domain AND localhost during a rollout):
#   CLIENT_URL="https://your-app.pages.dev,http://localhost:3000"
CLIENT_URL="http://localhost:3000"

# --- Pricing (REQUIRED) ----------------------------------------------------
# Default price per dog per night. Total = nights * dogs * this value.
PRICE_PER_DOG_PER_NIGHT=45

# --- Email (OPTIONAL - Nodemailer / SMTP) ----------------------------------
# If unset, email sending is skipped. Configure all of these to enable email.
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT=587
EMAIL_USER="your-email@gmail.com"
EMAIL_PASS="your-app-password"
EMAIL_FROM="Dog Hotel <your-email@gmail.com>"
